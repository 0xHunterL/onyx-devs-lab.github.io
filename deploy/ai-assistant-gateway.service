[Unit]
Description=Mimimi AI Assistant Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ai-assistant-gateway
EnvironmentFile=/opt/ai-assistant-gateway/.env
EnvironmentFile=/opt/ai-assistant-gateway/.env.deepseek
EnvironmentFile=/opt/ai-assistant-gateway/.env.database
Environment=CORS_ORIGINS=https://onyxdevslab.com,https://www.onyxdevslab.com,https://hk.onyxdevslab.com,https://onyx-devs-lab.github.io
Environment=RATE_LIMIT_PER_MINUTE=6
Environment=RATE_LIMIT_PER_HOUR=60
Environment=GLOBAL_DAILY_REQUEST_LIMIT=1000
ExecStartPre=/opt/ai-assistant-gateway/.venv/bin/python /opt/ai-assistant-gateway/migrate.py
ExecStart=/opt/ai-assistant-gateway/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8101 --no-access-log
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
